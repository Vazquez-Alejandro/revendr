rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuth() { return request.auth != null }
    function isOwner(userId) { return isAuth() && request.auth.uid == userId }
    function isAdmin() { return isAuth() && (
      request.auth.token.email == 'vazquezale82@gmail.com' ||
      get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.role in ['admin', 'super_admin']
    )}
    function sameUser(resource) { return resource.data.user_id == request.auth.uid || resource.data.userId == request.auth.uid }
    function ownerOrAdmin(resource) { return sameUser(resource) || isAdmin() }

    match /usuarios/{userId} {
      allow read, write: if isOwner(userId) || isAdmin()
    }

    match /api_keys/{keyId} {
      allow read, write: if isAuth() && ownerOrAdmin(resource)
      allow create: if isAuth()
    }

    match /campanias/{campaignId} {
      allow read, update, delete: if isAuth() && sameUser(resource)
      allow create: if isAuth()
    }

    match /leads/{leadId} {
      allow read, update, delete: if isAuth() && sameUser(resource)
      allow create: if isAuth()
    }

    match /productos/{productId} {
      allow read: if isAuth()
      allow create: if isAuth()
      allow update, delete: if isAuth() && sameUser(resource)
    }

    match /propuestas/{propuestaId} {
      allow read: if isAuth() && sameUser(resource)
      allow create, update: if isAuth()
      allow delete: if isAuth() && sameUser(resource)
    }

    match /crm_events/{eventId} {
      allow read, update, delete: if isAuth() && sameUser(resource)
      allow create: if isAuth()
    }

    match /revenue/{revenueId} {
      allow read, update, delete: if isAuth() && sameUser(resource)
      allow create: if isAuth()
    }

    match /team_members/{memberId} {
      allow read, update, delete: if isAuth() && sameUser(resource)
      allow create: if isAuth()
    }

    match /team_invites/{inviteId} {
      allow read, update, delete: if isAuth() && sameUser(resource)
      allow create: if isAuth()
    }

    match /generated_content/{docId} {
      allow read, update, delete: if isAuth() && sameUser(resource)
      allow create: if isAuth()
    }

    match /ab_tests/{docId} {
      allow read, update, delete: if isAuth() && sameUser(resource)
      allow create: if isAuth()
    }

    match /support_tickets/{ticketId} {
      allow read, update: if isAuth() && sameUser(resource)
      allow create: if isAuth()
    }

    match /chat_messages/{docId} {
      allow read: if isAuth() && sameUser(resource)
      allow create: if isAuth()
    }

    match /config_demos/{nicheId} {
      allow read: if isAuth()
      allow write: if isAdmin()
    }

    match /landing_views/{viewId} {
      allow read: if isAuth()
      allow create: if isAuth()
    }

    match /landing_engagement/{engagementId} {
      allow read: if isAuth()
      allow create: if isAuth()
    }

    match /notificaciones/{notifId} {
      allow read, update: if isAuth() && sameUser(resource)
      allow create: if isAuth()
    }

    match /notifications/{notifId} {
      allow read, update: if isAuth() && sameUser(resource)
      allow create: if isAuth()
    }

    match /message_log/{msgId} {
      allow read: if isAuth() && sameUser(resource)
      allow create: if isAuth()
    }

    match /message_events/{msgId} {
      allow read: if isAuth() && sameUser(resource)
      allow create: if isAuth()
    }

    match /whatsapp_conversations/{convId} {
      allow read, update: if isAuth() && sameUser(resource)
      allow create: if isAuth()
    }

    match /whatsapp_messages/{msgId} {
      allow read: if isAuth() && sameUser(resource)
      allow create: if isAuth()
    }

    match /scheduled_messages/{msgId} {
      allow read, update, delete: if isAuth() && sameUser(resource)
      allow create: if isAuth()
    }

    match /blacklist/{entryId} {
      allow read, delete: if isAuth() && sameUser(resource)
      allow create: if isAuth()
    }

    match /checkout_sessions/{sessionId} {
      allow read, write: if isAdmin()
      allow create: if isAuth()
    }

    match /_health/{docId} {
      allow read, write: if isAdmin()
    }
  }
}